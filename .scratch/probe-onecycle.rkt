#lang racket/base
(require (only-in racket/math pi))
(printf "(/ 0 0.0)   = ~a\n" (/ 0 0.0))
(printf "(/ 0.0 0.0) = ~a\n" (/ 0.0 0.0))
(printf "(/ 1.0 0.0) = ~a\n" (/ 1.0 0.0))
(define (anneal start end pct)
  (+ end (* (/ (- start end) 2.0) (+ 1.0 (cos (* pi pct))))))
(define (rate max-lr total-steps pct-start t)
  (define initial (/ max-lr 25.0))
  (define final (/ initial 1e4))
  (define up-end (- (* pct-start total-steps) 1.0))
  (define down-end (- total-steps 1.0))
  (if (<= t up-end)
      (anneal initial max-lr (/ t up-end))
      (anneal max-lr final (/ (- t up-end) (- down-end up-end)))))
(printf "pct .1  steps 10, t=0: ~a\n" (rate 0.1 10 0.1 0))
(printf "pct .1  steps 10, t=1: ~a\n" (rate 0.1 10 0.1 1))
(printf "pct 1.0 steps 10, t=9: ~a\n" (rate 0.1 10 1.0 9))
(printf "pct 1.0 steps 10, t=10: ~a\n" (rate 0.1 10 1.0 10))
(printf "pct .05 steps 10, t=0: ~a\n" (rate 0.1 10 0.05 0))
