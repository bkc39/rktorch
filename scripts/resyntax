#!/usr/bin/env bash
#
# Resyntax with this repository's suite: the default recommendations plus
# the rules in scripts/resyntax-rules.rkt, tested by
# scripts/resyntax-rules-test.rkt. Resyntax skips #lang scribble/lp2, so
# scripts/resyntax-lp2.rkt then lints the literate examples' chunks with
# the same suite; it takes --file, --directory, --local-git-repository and
# --analyzer-timeout.
#
# --local-git-repository DIR [REF] diffs against the merge base of HEAD and
# REF, so only the branch's own changes are linted. REF defaults to the base
# of the open pull request for the branch, or for HEAD's commit when HEAD is
# detached (gh), when origin has that base; else origin/master. Tested by
# scripts/resyntax-wrapper-test.rkt.
#
#   nix develop .#ci --command scripts/resyntax analyze \
#     --local-git-repository . --analyzer-timeout 30000
#   nix develop .#ci --command scripts/resyntax fix \
#     --local-git-repository .
set -euo pipefail

fail() {
  echo "resyntax: $*" >&2
  exit 2
}

pr_base() {
  if git symbolic-ref -q HEAD >/dev/null; then
    timeout 20 gh pr view --json state,baseRefName \
      --jq '.state + " " + .baseRefName' 2>/dev/null |
      awk '$1 == "OPEN" { print $2 }'
  else
    timeout 20 gh pr list --state open --limit 200 \
      --json headRefOid,baseRefName \
      --jq '.[] | .headRefOid + " " + .baseRefName' 2>/dev/null |
      awk -v head="$(git rev-parse HEAD)" '$1 == head { print $2 }'
  fi
}

default_ref() {
  local name
  name=$(cd "$1" && pr_base) || name=
  if [ -n "$name" ] &&
     git -C "$1" rev-parse -q --verify "origin/$name^{commit}" >/dev/null; then
    echo "origin/$name"
  else
    echo origin/master
  fi
}

root=$(git rev-parse --show-toplevel)
command=$1
shift
args=()
while [ $# -gt 0 ]; do
  if [ "$1" != --local-git-repository ]; then
    args+=("$1")
    shift
    continue
  fi
  if [ $# -lt 2 ] || [[ $2 == --* ]]; then
    fail "--local-git-repository needs DIR [REF]"
  fi
  dir=$2
  shift 2
  if [ $# -gt 0 ] && [[ $1 != --* ]]; then
    ref=$1
    shift
  else
    ref=$(default_ref "$dir")
  fi
  base=$(git -C "$dir" merge-base HEAD "$ref") ||
    fail "no merge base of HEAD and $ref in $dir" \
         "(shallow clone or unrelated history?)"
  echo "resyntax: linting changes since $ref (merge base ${base:0:12})" >&2
  args+=(--local-git-repository "$dir" "$base")
done
lp2_flags=()
if [ "$command" = fix ]; then
  lp2_flags=(--fix)
fi
rc=0
resyntax "$command" \
  --refactoring-suite "(file \"$root/scripts/resyntax-rules.rkt\")" \
  rktorch-recommendations "${args[@]}" || rc=$?
racket "$root/scripts/resyntax-lp2.rkt" "${lp2_flags[@]}" "${args[@]}" || rc=$?
exit "$rc"
