#!/usr/bin/env bash
#
# Fast Resyntax for the edit->lint inner loop: analyze only the .rkt files this
# branch changed against its base, not the whole tree. `resyntax analyze
# --directory torch` takes half an hour, which is too slow to run per edit.
#
# Not a replacement for the CI gate, which sweeps all of torch/ and so catches
# suggestions in files this branch never touched. Note CI scopes itself to
# torch/; this script also covers scripts/ and examples/, so it can flag files
# CI would not.
#
# Usage: scripts/resyntax-changed [base-ref]      (default: origin/master)
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

base="${1:-${RESYNTAX_BASE:-origin/master}}"
if ! merge_base=$(git merge-base "$base" HEAD 2>/dev/null); then
  echo "resyntax-changed: no merge base with '$base'" >&2
  exit 2
fi

# Working tree vs the merge base: committed branch work plus anything still
# uncommitted, which is what you want while iterating.
mapfile -t files < <(
  git diff --name-only --diff-filter=ACMR "$merge_base" -- '*.rkt' | sort -u
)
existing=()
for f in "${files[@]}"; do
  [ -f "$f" ] && existing+=("$f")
done

if [ "${#existing[@]}" -eq 0 ]; then
  echo "resyntax-changed: no changed .rkt files against $base"
  exit 0
fi

echo "resyntax-changed: analyzing ${#existing[@]} file(s) against $base:"
printf '  %s\n' "${existing[@]}"

args=()
for f in "${existing[@]}"; do
  args+=(--file "$f")
done

# Same detection as the CI gate: resyntax exits 0 even when it has suggestions,
# so the suggestion lines themselves are the signal.
out=$(resyntax analyze "${args[@]}" --analyzer-timeout 30000 2>&1)
echo "$out"
if echo "$out" | grep -qE "resyntax: .*\.rkt:[0-9]+:[0-9]+ \["; then
  echo "resyntax-changed: suggestions found. Fix: resyntax fix ${args[*]}" >&2
  exit 1
fi
timeouts=$(echo "$out" | grep -c "timed out" || true)
if [ "$timeouts" -gt 0 ]; then
  echo "resyntax-changed: analyzer timed out on $timeouts file(s); partial." >&2
fi
echo "resyntax-changed: no suggestions."
