#!/usr/bin/env bash
#
# Analyze only the .rkt files this branch changed against its base.
#
# Not a replacement for the CI gate: that sweeps all of torch/, so it catches
# files this branch never touched. It is also scoped to torch/, while this
# covers scripts/ and examples/ too -- so this can flag files CI would not.
#
# Usage: scripts/resyntax-changed [base-ref]      (default: origin/master)
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

base="${1:-${RESYNTAX_BASE:-origin/master}}"
if ! merge_base=$(git merge-base "$base" HEAD 2>/dev/null); then
  echo "resyntax-changed: no merge base with '$base'" >&2
  exit 2
fi

# Committed branch work, uncommitted edits, and files not yet added -- git diff
# reports none of the last, so a brand new .rkt would otherwise go unlinted.
mapfile -t files < <(
  {
    git diff --name-only --diff-filter=ACMR "$merge_base" -- '*.rkt'
    git ls-files --others --exclude-standard -- '*.rkt'
  } | sort -u
)
existing=()
for f in "${files[@]}"; do
  [ -f "$f" ] && existing+=("$f")
done

if [ "${#existing[@]}" -eq 0 ]; then
  echo "resyntax-changed: no changed .rkt files against $base"
  exit 0
fi

echo "resyntax-changed: analyzing ${#existing[@]} file(s) against $base:"
printf '  %s\n' "${existing[@]}"

args=()
for f in "${existing[@]}"; do
  args+=(--file "$f")
done

# Same detection as the CI gate: resyntax exits 0 even when it has suggestions,
# so the suggestion lines themselves are the signal.
# A here-string, not a pipe: under `set -o pipefail`, `grep -q` closes early on
# a match, the writer takes SIGPIPE, and the pipeline yields 141 -- so a found
# suggestion would report as none.
out=$(resyntax analyze "${args[@]}" --analyzer-timeout 30000 2>&1)
echo "$out"
if grep -qE "resyntax: .*\.rkt:[0-9]+:[0-9]+ \[" <<<"$out"; then
  echo "resyntax-changed: suggestions found. Fix: resyntax fix ${args[*]}" >&2
  exit 1
fi
timeouts=$(echo "$out" | grep -c "timed out" || true)
if [ "$timeouts" -gt 0 ]; then
  echo "resyntax-changed: analyzer timed out on $timeouts file(s); partial." >&2
fi
echo "resyntax-changed: no suggestions."
